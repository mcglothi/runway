{
  "name": "@runway/electron",
  "version": "0.1.1",
  "description": "Runway system tray widget",
  "author": {
    "name": "Tim McGlothlin",
    "email": "tim@mcglothin.net"
  },
  "homepage": "https://github.com/mcglothi/runway",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "@runway/core": "*"
  },
  "devDependencies": {
    "7zip-bin": "~5.2.0",
    "electron": "34.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.mcglothi.runway",
    "productName": "Runway",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "build-assets",
      "output": "../../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.html",
      "settings.html",
      "discovery.js",
      "build-assets/**/*",
      "../../packages/core/src/**/*",
      "../../packages/core/package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "build-assets/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build-assets/entitlements.mac.plist",
      "entitlementsInherit": "build-assets/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "icon": "build-assets/icons",
      "desktop": {
        "StartupNotify": "false"
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build-assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "protocols": [
      {
        "name": "Runway",
        "schemes": ["runway"]
      }
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "mcglothi",
      "repo": "runway"
    }
  },
  "license": "MIT"
}

# Claude (Pro / Max subscription)
# Copy sessionKey from browser devtools: Application > Cookies > claude.ai > sessionKey
CLAUDE_SESSION_KEY=
CLAUDE_ORG_ID=

# Codex / OpenAI (paid API — admin key with org:read scope)
OPENAI_API_KEY=

# AIKB integration (optional)
# Path to your AIKB _runtime/events/ directory
AIKB_EVENTS_PATH=
# Snapshot interval in seconds (default: 300)
AIKB_SNAPSHOT_INTERVAL=300

# Poll interval in seconds for usage API calls (default: 120)
POLL_INTERVAL=120
